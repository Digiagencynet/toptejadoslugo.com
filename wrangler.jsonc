{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tejados-lugo",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": { "enabled": true }
}
